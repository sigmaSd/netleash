# Installed in /usr/lib/systemd/system/. Started on demand through D-Bus.
[Unit]
Description=netleash: per-app network traffic and limits

[Service]
Type=dbus
BusName=io.github.sigmasd.Netleash
ExecStart=/usr/bin/netleash --dbus
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
